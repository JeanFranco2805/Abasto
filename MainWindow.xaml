<Window x:Class="SupermercadoPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supermercado POS"
        Width="1280" Height="800" MinWidth="1024" MinHeight="650" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        FontFamily="Segoe UI" xml:lang="es-CO" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="#142B49" Padding="24,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" Background="#1CFFFFFF" CornerRadius="12" Margin="0,0,12,0">
            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SUPERMERCADO POS" Foreground="White" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="Punto de venta local" Foreground="#B7C6D8" FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#1E3A5F" CornerRadius="16" Padding="12,7" VerticalAlignment="Center" Margin="0,0,18,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#32D583" VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock Text="Base local disponible" Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
          <TextBlock x:Name="UserRoleText" Foreground="#B7C6D8" FontSize="12" HorizontalAlignment="Right" />
        </StackPanel>
        <Button x:Name="ShiftButton" Grid.Column="3" Content="Abrir turno" Click="Shift_Click"
                Background="#FFFFFF" Foreground="#142B49" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18" TabStripPlacement="Left"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                SelectionChanged="MainTabs_SelectionChanged">
      <TabItem x:Name="SalesTab" Header="Punto de venta" Tag="&#xE7BF;">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="1.1*" />
          </Grid.ColumnDefinitions>

          <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,12,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="Productos" FontSize="21" FontWeight="Bold" Foreground="#172B4D" />
                  <TextBlock Text="Busca por nombre o escanea el código." FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="ProductCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#667085" Margin="24,0,0,0" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,15,0,10">
                <TextBox x:Name="SearchBox" ToolTip="Buscar por nombre, categoría o código de barras"
                         TextChanged="Search_TextChanged" />
                <TextBlock Text="Buscar producto por nombre, categoría o código de barras"
                           Foreground="#98A2B3" Margin="12,0,8,0" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <TextBox x:Name="BarcodeBox" ToolTip="Escanea o escribe el código de barras"
                           KeyDown="Barcode_KeyDown" />
                  <TextBlock Text="Escanear o escribir código de barras y pulsar Enter"
                             Foreground="#98A2B3" Margin="12,0,8,0" VerticalAlignment="Center"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=BarcodeBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <Button Grid.Column="1" Content="Agregar código" Click="BarcodeAdd_Click"
                        Background="#E9EEF5" Margin="8,0,0,0" />
              </Grid>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProductsPanel">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="220" Height="140" Margin="0,0,12,12" Padding="0" Background="White"
                              BorderBrush="#EAECF0" BorderThickness="1" HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" Tag="{Binding}" Click="Product_Click">
                        <Border Padding="14" CornerRadius="11">
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <Border Background="#EEF4FF" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#175CD3" />
                              </Border>
                              <Border Grid.Column="1" Background="#F2F4F7" CornerRadius="6" Padding="7,3">
                                <TextBlock Text="{Binding Unit}" FontSize="10" FontWeight="Bold" Foreground="#475467" />
                              </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,5">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#172B4D"
                                         TextWrapping="Wrap" MaxHeight="40" />
                              <TextBlock Text="{Binding Barcode}" FontSize="10" Foreground="#98A2B3" Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                              <TextBlock Text="{Binding Stock, StringFormat='Existencias: {0:N2}'}" FontSize="10"
                                         Foreground="#667085" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding UnitPrice, StringFormat=C0}" FontSize="16"
                                         FontWeight="Bold" Foreground="#155EEF" HorizontalAlignment="Right" />
                            </Grid>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Venta actual" FontSize="21" FontWeight="Bold" Foreground="#172B4D" />
                  <TextBlock x:Name="CartCountText" Text="Venta vacía · lista para empezar" FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Vaciar" Click="ClearCart_Click" Padding="10,6" />
              </Grid>
              <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="9" Padding="10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="CLIENTE (OPCIONAL)" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="0,0,0,4" />
                    <TextBox x:Name="CustomerNameBox" FontSize="12" Padding="7,5" ToolTip="Nombre del cliente para el comprobante" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DOCUMENTO" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="0,0,0,4" />
                    <TextBox x:Name="CustomerDocumentBox" FontSize="12" Padding="7,5" ToolTip="Documento del cliente" />
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Grid.Row="2">
                <ListBox x:Name="CartList" ItemsSource="{Binding Cart}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#344054" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UnitPrice, StringFormat=C0}" FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding DiscountLabel}" FontSize="10" Foreground="#B54708" Margin="0,2,0,0" />
                            <Button Content="Descuento" Padding="4,2" FontSize="10" Margin="0,3,0,0"
                                    Tag="{Binding}" Click="Discount_Click" HorizontalAlignment="Left" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Button Content="−" Padding="8,4" Tag="{Binding}" Click="Decrease_Click" />
                            <TextBlock Text="{Binding QuantityText}" VerticalAlignment="Center" MinWidth="58"
                                       TextAlignment="Center" FontSize="12" />
                            <Button Content="+" Padding="8,4" Tag="{Binding}" Click="Increase_Click" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="82">
                            <TextBlock Text="{Binding LineTotal, StringFormat=C0}" FontWeight="Bold"
                                       Foreground="#172B4D" HorizontalAlignment="Right" />
                            <Button Content="Quitar" Padding="3,2" FontSize="11" Background="Transparent"
                                    Foreground="#B42318" Tag="{Binding}" Click="RemoveLine_Click" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22"
                            IsHitTestVisible="False">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Width="62" Height="62" Background="#EEF4FF" CornerRadius="20"
                          HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#155EEF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Tu venta está vacía" FontSize="16" FontWeight="SemiBold"
                             Foreground="#344054" HorizontalAlignment="Center" />
                  <TextBlock Text="Elige un producto del catálogo o escanea su código."
                             FontSize="12" Foreground="#98A2B3" TextAlignment="Center"
                             TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,16" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#F2F4F7" CornerRadius="6" Padding="8,5" Margin="0,0,7,0">
                      <TextBlock Text="F2  Buscar" FontSize="10" FontWeight="SemiBold" Foreground="#667085" />
                    </Border>
                    <Border Background="#F2F4F7" CornerRadius="6" Padding="8,5">
                      <TextBlock Text="F3  Escanear" FontSize="10" FontWeight="SemiBold" Foreground="#667085" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Subtotal" Foreground="#667085" /><TextBlock x:Name="SubtotalText" Grid.Column="1" Foreground="#344054" />
                </Grid>
                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Descuentos" Foreground="#667085" /><TextBlock x:Name="DiscountText" Grid.Column="1" Foreground="#B54708" />
                </Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Impuestos" Foreground="#667085" /><TextBlock x:Name="TaxText" Grid.Column="1" Foreground="#344054" />
                </Grid>
                <Border Height="1" Background="#EAECF0" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="TOTAL" FontSize="15" FontWeight="Bold" Foreground="#172B4D" />
                  <TextBlock x:Name="TotalText" Grid.Column="1" FontSize="23" FontWeight="Bold" Foreground="#155EEF" />
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Button Content="Suspender" Click="SuspendSale_Click" />
                  <Button Grid.Column="2" Content="Reanudar" Click="ResumeSale_Click" />
                  <Button x:Name="ChargeButton" Grid.Column="4" Content="Cobrar venta" Click="Charge_Click" Background="#155EEF"
                          Foreground="White" FontSize="14" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="ShiftTab" Header="Turnos y caja" Tag="&#xE8D7;">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Turno de caja" FontSize="22" FontWeight="Bold" Foreground="#172B4D" />
              <TextBlock Text="Controla el fondo, los movimientos y el arqueo del cajero." Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar" Click="RefreshShiftPage_Click" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Gestionar turno" Click="Shift_Click" VerticalAlignment="Center"
                    Background="#155EEF" Foreground="White" />
          </Grid>
          <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="ESTADO" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock x:Name="ShiftStatusText" Text="Sin turno abierto" FontSize="19" FontWeight="Bold" Foreground="#B54708" Margin="0,6,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="FONDO INICIAL" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock x:Name="ShiftOpeningText" Text="$ 0" FontSize="19" FontWeight="Bold" Foreground="#172B4D" Margin="0,6,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="EFECTIVO ESPERADO" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock x:Name="ShiftExpectedText" Text="$ 0" FontSize="19" FontWeight="Bold" Foreground="#155EEF" Margin="0,6,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16">
              <StackPanel><TextBlock Text="APERTURA" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock x:Name="ShiftOpenedText" Text="--" FontSize="19" FontWeight="Bold" Foreground="#172B4D" Margin="0,6,0,0" /></StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Grid.Row="2" Text="Actividad reciente" FontSize="17" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,8" />
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Movimientos del turno actual" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,8" />
                <DataGrid x:Name="ShiftMovementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeight="36" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Hora" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:HH:mm}'}" Width="75" />
                    <DataGridTemplateColumn Header="Tipo" Width="90">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Salida" />
                                <Setter Property="Foreground" Value="#B42318" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsCashIn}" Value="True">
                                    <Setter Property="Text" Value="Entrada" />
                                    <Setter Property="Foreground" Value="#067647" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C0}" Width="110" />
                    <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Historial de turnos" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,8" />
                <DataGrid x:Name="ShiftHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeight="36" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Cajero" Binding="{Binding CashierName}" Width="*" />
                    <DataGridTextColumn Header="Apertura" Binding="{Binding OpenedAtUtc, StringFormat='{}{0:dd/MM HH:mm}'}" Width="125" />
                    <DataGridTextColumn Header="Cierre" Binding="{Binding ClosedAtUtc, StringFormat='{}{0:dd/MM HH:mm}'}" Width="125" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="85" />
                    <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference, StringFormat=C0}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="InventoryTab" Header="Inventario" Tag="&#xE7B8;">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Inventario y catálogo" FontSize="23" FontWeight="Bold" Foreground="#172B4D" />
              <TextBlock x:Name="InventorySummaryText" Foreground="#667085" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="EditInventoryButton" Grid.Column="1" Content="Editar producto"
                    Click="EditProduct_Click" IsEnabled="False" Margin="10,0,0,0" />
            <Button Grid.Column="2" Content="＋  Nuevo producto" Click="NewProduct_Click"
                    Background="#155EEF" Foreground="White" Margin="10,0,0,0" />
          </Grid>
          <Border Grid.Row="1" Background="White" BorderBrush="#E6EBF3" BorderThickness="1"
                  CornerRadius="13" Padding="12" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Margin="0,0,8,0">
                <TextBox x:Name="InventorySearchBox" Padding="13,10" ToolTip="Buscar por nombre, código o categoría"
                         TextChanged="InventorySearch_TextChanged" />
                <TextBlock Text="⌕  Buscar producto, código o categoría" Foreground="#98A2B3"
                           Margin="13,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=InventorySearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <ComboBox x:Name="InventoryCategoryFilterBox" Grid.Column="1" Margin="8,0" Padding="10,8"
                        ItemsSource="{Binding InventoryCategories}" SelectedIndex="0"
                        SelectionChanged="InventoryFilters_SelectionChanged" ToolTip="Filtrar por categoría" />
              <ComboBox x:Name="InventoryStockFilterBox" Grid.Column="2" Margin="8,0" Padding="10,8"
                        SelectedIndex="0" SelectionChanged="InventoryFilters_SelectionChanged"
                        ToolTip="Filtrar por nivel de existencias">
                <ComboBoxItem Content="Todos los niveles" Tag="all" />
                <ComboBoxItem Content="Existencias bajas" Tag="low" />
                <ComboBoxItem Content="Sin existencias" Tag="empty" />
                <ComboBoxItem Content="Stock suficiente" Tag="available" />
              </ComboBox>
              <ComboBox x:Name="InventorySortBox" Grid.Column="3" Margin="8,0" Padding="10,8"
                        SelectedIndex="0" SelectionChanged="InventoryFilters_SelectionChanged"
                        ToolTip="Ordenar productos">
                <ComboBoxItem Content="Nombre: A a Z" Tag="name" />
                <ComboBoxItem Content="Precio: menor primero" Tag="price-asc" />
                <ComboBoxItem Content="Precio: mayor primero" Tag="price-desc" />
                <ComboBoxItem Content="Menor existencia" Tag="stock-asc" />
              </ComboBox>
              <Button Grid.Column="4" Content="Limpiar" Click="ClearInventoryFilters_Click"
                      Margin="8,0,0,0" Padding="12,9" />
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ListBox x:Name="InventoryCardsList" ItemsSource="{Binding InventoryProducts}"
                     Background="Transparent" BorderThickness="0" SelectionMode="Single"
                     SelectionChanged="InventoryCardsList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Width" Value="344" />
                  <Setter Property="MinHeight" Value="205" />
                  <Setter Property="Margin" Value="0,0,14,14" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="CardSurface" Opacity="0" RenderTransformOrigin="0.5,0.5">
                          <Grid.RenderTransform>
                            <TransformGroup>
                              <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                              <TranslateTransform x:Name="CardOffset" Y="10" />
                            </TransformGroup>
                          </Grid.RenderTransform>
                          <Border x:Name="CardBorder" Background="White" BorderBrush="#E4EAF2"
                                  BorderThickness="1" CornerRadius="15" Padding="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                          </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.24" />
                                <DoubleAnimation Storyboard.TargetName="CardOffset" Storyboard.TargetProperty="Y"
                                                 From="10" To="0" Duration="0:0:0.24" />
                              </Storyboard>
                            </BeginStoryboard>
                          </EventTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#9CB9F5" />
                            <Setter TargetName="CardBorder" Property="Effect">
                              <Setter.Value>
                                <DropShadowEffect Color="#456AA5" BlurRadius="18" ShadowDepth="4" Opacity="0.13" />
                              </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                   To="1.018" Duration="0:0:0.15" />
                                  <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                   To="1.018" Duration="0:0:0.15" />
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                   To="1" Duration="0:0:0.15" />
                                  <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                   To="1" Duration="0:0:0.15" />
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.ExitActions>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#155EEF" />
                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFF" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                      <Border Background="#F2F4F7" CornerRadius="8" Padding="9,5" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="#475467" />
                      </Border>
                      <Border Background="{Binding StockStatusBackground}" CornerRadius="8" Padding="9,5"
                              HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="6" Height="6" Fill="{Binding StockStatusForeground}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding StockStatus}" FontSize="10" FontWeight="Bold"
                                     Foreground="{Binding StockStatusForeground}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,13,0,12" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="#172B4D"
                                 TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#98A2B3" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="#667085" />
                      </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,9,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PRECIO UNITARIO" FontSize="9" FontWeight="Bold" Foreground="#98A2B3" />
                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C0}}" FontSize="20"
                                   FontWeight="Bold" Foreground="#155EEF" Margin="0,2,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#F4F7FB" CornerRadius="10" Padding="11,8"
                              VerticalAlignment="Center">
                        <StackPanel>
                          <TextBlock Text="EXISTENCIAS" FontSize="9" FontWeight="Bold" Foreground="#98A2B3" />
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Stock, StringFormat={}{0:N3}}" FontSize="13"
                                       FontWeight="Bold" Foreground="#344054" />
                            <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#667085"
                                       VerticalAlignment="Center" Margin="5,0,0,0" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Mín." FontSize="10" Foreground="#98A2B3" />
                            <TextBlock Text="{Binding MinimumStock, StringFormat={}{0:N3}}" FontSize="10"
                                       Foreground="#667085" Margin="4,0,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="InventoryEmptyStatePanel" Background="#F3F5F8" Visibility="Collapsed"
                    IsHitTestVisible="False">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="58" Height="58" Background="#E8F0FF" CornerRadius="18"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#155EEF"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No encontramos productos" FontSize="18" FontWeight="Bold" Foreground="#172B4D"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Prueba con otra búsqueda o cambia los filtros para ver más resultados."
                           FontSize="13" Foreground="#667085" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,7,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="InventoryRangeText" Foreground="#667085" FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Productos por página" Foreground="#667085" FontSize="12"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="InventoryPageSizeBox" Width="78" SelectedIndex="0" Margin="0,0,14,0"
                        SelectionChanged="InventoryPageSize_SelectionChanged" ToolTip="Tamaño de página">
                <ComboBoxItem Content="8" Tag="8" />
                <ComboBoxItem Content="12" Tag="12" />
                <ComboBoxItem Content="20" Tag="20" />
              </ComboBox>
              <Button x:Name="InventoryPreviousPageButton" Content="‹" Width="40" Padding="8,6"
                      Click="InventoryPreviousPage_Click" ToolTip="Página anterior" />
              <Border Background="#EAF1FF" CornerRadius="8" Padding="13,8" Margin="8,0">
                <TextBlock x:Name="InventoryPageText" Foreground="#155EEF" FontWeight="SemiBold"
                           FontSize="12" VerticalAlignment="Center" />
              </Border>
              <Button x:Name="InventoryNextPageButton" Content="›" Width="40" Padding="8,6"
                      Click="InventoryNextPage_Click" ToolTip="Página siguiente" />
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="ReportsTab" Header="Reportes" Tag="&#xE9D2;">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Reportes de ventas" FontSize="22" FontWeight="Bold" Foreground="#172B4D" />
              <TextBlock Text="Filtra el periodo y consulta ventas, medios de pago y productos." Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="Desde" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,3" />
              <DatePicker x:Name="ReportFromDate" Width="140" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="Hasta" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Margin="0,0,0,3" />
              <DatePicker x:Name="ReportToDate" Width="140" />
            </StackPanel>
            <Button Grid.Column="3" Content="Actualizar" Click="RefreshReport_Click" VerticalAlignment="Center"
                    Background="#155EEF" Foreground="White" />
          </Grid>
          <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="Ventas" Foreground="#667085" /><TextBlock x:Name="TodayCountText" FontSize="24" FontWeight="Bold" Foreground="#172B4D" Margin="0,5,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="Total vendido" Foreground="#667085" /><TextBlock x:Name="TodayTotalText" FontSize="24" FontWeight="Bold" Foreground="#155EEF" Margin="0,5,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="Efectivo" Foreground="#667085" /><TextBlock x:Name="TodayCashText" FontSize="24" FontWeight="Bold" Foreground="#172B4D" Margin="0,5,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16">
              <StackPanel><TextBlock Text="Tarjeta y otros" Foreground="#667085" /><TextBlock x:Name="TodayOtherText" FontSize="24" FontWeight="Bold" Foreground="#172B4D" Margin="0,5,0,0" /></StackPanel>
            </Border>
          </UniformGrid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Ventas del periodo" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,8" />
                <DataGrid x:Name="RecentSalesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0" RowHeight="38">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Reimprimir comprobante" Click="ReprintSale_Click" />
                      <MenuItem Header="Anular venta en efectivo" Click="VoidSale_Click" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Venta" Binding="{Binding Id, StringFormat='Venta #{0}'}" Width="110" />
                    <DataGridTextColumn Header="Fecha y hora" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="155" />
                    <DataGridTextColumn Header="Cajero" Binding="{Binding CashierName}" Width="*" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="105" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C0}" Width="135" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12">
              <TabControl TabStripPlacement="Top" Background="Transparent">
                <TabItem Header="Productos" Tag="&#xE7B8;" Width="125" Padding="8,7">
                  <Grid Margin="4">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,5">
                      <TextBlock DockPanel.Dock="Top" Text="Más vendidos" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,6" />
                      <DataGrid x:Name="ProductPerformanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0" RowHeight="32">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
                          <DataGridTextColumn Header="Cant." Binding="{Binding QuantitySold, StringFormat=N2}" Width="70" />
                          <DataGridTextColumn Header="Venta" Binding="{Binding Revenue, StringFormat=C0}" Width="100" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,5,0,0">
                      <TextBlock DockPanel.Dock="Top" Text="Menos vendidos" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,6" />
                      <DataGrid x:Name="LowProductPerformanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0" RowHeight="32">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
                          <DataGridTextColumn Header="Cant." Binding="{Binding QuantitySold, StringFormat=N2}" Width="70" />
                          <DataGridTextColumn Header="Venta" Binding="{Binding Revenue, StringFormat=C0}" Width="100" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                  </Grid>
                </TabItem>
                <TabItem Header="Cajeros" Tag="&#xE77B;" Width="125" Padding="8,7">
                  <DataGrid x:Name="CashierPerformanceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                            HeadersVisibility="Column" Background="White" BorderThickness="0" RowHeight="38" Margin="4">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Cajero" Binding="{Binding CashierName}" Width="*" />
                      <DataGridTextColumn Header="Ventas" Binding="{Binding SalesCount}" Width="72" />
                      <DataGridTextColumn Header="Total" Binding="{Binding GrossSales, StringFormat=C0}" Width="115" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="Turnos" Tag="&#xE8D7;" Width="125" Padding="8,7">
                  <DataGrid x:Name="ShiftPerformanceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                            HeadersVisibility="Column" Background="White" BorderThickness="0" RowHeight="38" Margin="4">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="N.º" Binding="{Binding ShiftId}" Width="65" />
                      <DataGridTextColumn Header="Cajero" Binding="{Binding CashierName}" Width="*" />
                      <DataGridTextColumn Header="Ventas" Binding="{Binding SalesCount}" Width="72" />
                      <DataGridTextColumn Header="Total" Binding="{Binding GrossSales, StringFormat=C0}" Width="115" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
              </TabControl>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="AuditTab" Header="Auditoría" Tag="&#xE8D4;">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Auditoría" FontSize="22" FontWeight="Bold" Foreground="#172B4D" />
              <TextBlock Text="Registro de operaciones realizadas por usuarios en este punto de venta." Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar" Click="RefreshAudit_Click" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12">
            <DataGrid x:Name="AuditEventsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeight="38" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha y hora" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="190" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="180" />
                <DataGridTextColumn Header="Operación" Binding="{Binding Operation}" Width="220" />
                <DataGridTextColumn Header="Detalle" Binding="{Binding Details}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="SyncTab" Header="Conectividad" Tag="&#xE703;">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Conectividad y resiliencia" FontSize="22" FontWeight="Bold" Foreground="#172B4D" />
              <TextBlock Text="La caja opera con base local y conserva eventos para sincronización posterior." Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar estado" Click="RefreshConnectivity_Click" VerticalAlignment="Center" />
          </Grid>
          <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="OPERACIÓN LOCAL" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock Text="Disponible sin internet" FontSize="18" FontWeight="Bold" Foreground="#067647" Margin="0,6,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="COLA DE SINCRONIZACIÓN" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock x:Name="PendingSyncCountText" Text="0 pendientes" FontSize="18" FontWeight="Bold" Foreground="#155EEF" Margin="0,6,0,0" />
                <TextBlock x:Name="SyncStatusText" Text="Conector central no configurado" FontSize="11" Foreground="#667085" Margin="0,3,0,0" /></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="16">
              <StackPanel><TextBlock Text="ÚLTIMA COPIA LOCAL" FontSize="11" FontWeight="Bold" Foreground="#667085" />
                <TextBlock x:Name="LatestBackupText" Text="No disponible" FontSize="18" FontWeight="Bold" Foreground="#172B4D" Margin="0,6,0,0" />
                <TextBlock Text="Se conservan hasta 14 copias diarias." FontSize="11" Foreground="#667085" Margin="0,3,0,0" /></StackPanel>
            </Border>
          </UniformGrid>
          <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Eventos locales pendientes o enviados" FontWeight="Bold" Foreground="#344054" Margin="2,0,0,8" />
              <DataGrid x:Name="SyncQueueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" RowHeight="38" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="175" />
                  <DataGridTextColumn Header="Entidad" Binding="{Binding EntityType}" Width="120" />
                  <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="100" />
                  <DataGridTextColumn Header="Operación" Binding="{Binding Operation}" Width="200" />
                  <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120" />
                  <DataGridTextColumn Header="Intentos" Binding="{Binding Attempts}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="UsersTab" Header="Usuarios" Tag="&#xE77B;">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Usuarios y permisos" FontSize="22" FontWeight="Bold" Foreground="#172B4D" />
              <TextBlock Text="Administra cajeros, supervisores y administradores. Los PIN se almacenan protegidos." Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Restablecer PIN" Click="ResetUserPin_Click" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Activar / desactivar" Click="ToggleUserActive_Click" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Nuevo usuario" Click="NewUser_Click" VerticalAlignment="Center" Background="#155EEF" Foreground="White" />
          </Grid>
          <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeight="42" BorderThickness="0" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="220" />
                <DataGridTextColumn Header="Perfil" Binding="{Binding Role}" Width="180" />
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>

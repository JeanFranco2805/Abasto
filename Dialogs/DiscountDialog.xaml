<Window x:Class="SupermercadoPOS.Dialogs.DiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descuento autorizado"
        Width="500" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8"
        FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Aplicar descuento" FontSize="24" FontWeight="Bold" Foreground="#172B4D" />
      <TextBlock Text="El cambio requiere aprobación de supervisor." Foreground="#667085" Margin="0,4,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18">
      <StackPanel>
        <TextBlock Text="Porcentaje (0 a 100)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="PercentBox" Text="5" Margin="0,0,0,14" />
        <TextBlock Text="Usuario supervisor" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UsernameBox" Text="supervisor" Margin="0,0,0,14" />
        <TextBlock Text="PIN supervisor" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PinBox" Padding="10,8" FontSize="14" Margin="0,0,0,10" />
        <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,10,0" />
      <Button Content="Autorizar" Click="Authorize_Click" Background="#155EEF" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>

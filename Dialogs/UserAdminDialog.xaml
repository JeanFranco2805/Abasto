<Window x:Class="SupermercadoPOS.Dialogs.UserAdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuario" Width="480" Height="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI">
  <Border Margin="22" Padding="24" Background="White" CornerRadius="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="SEGURIDAD DEL PUNTO DE VENTA" FontSize="11" FontWeight="Bold" Foreground="#155EEF" />
        <TextBlock x:Name="HeadingText" Text="Crear usuario" FontSize="23" FontWeight="Bold" Foreground="#172B4D" Margin="0,5,0,0" />
        <TextBlock x:Name="SubtitleText" Text="Define el acceso y el perfil de esta persona." Foreground="#667085" Margin="0,3,0,0" />
      </StackPanel>
      <Border x:Name="TargetBorder" Grid.Row="1" Visibility="Collapsed" Background="#F8FAFC" CornerRadius="8" Padding="11" Margin="0,14,0,0">
        <TextBlock x:Name="TargetText" Foreground="#344054" FontWeight="SemiBold" />
      </Border>
      <StackPanel Grid.Row="2" Margin="0,18,0,0">
        <StackPanel x:Name="UserFields">
          <TextBlock Text="Nombre visible" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="DisplayNameBox" Margin="0,0,0,14" />
          <TextBlock Text="Usuario de acceso" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />
          <TextBlock Text="Perfil" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="RoleBox" SelectedIndex="0" Margin="0,0,0,14">
            <ComboBoxItem Content="Cajero" />
            <ComboBoxItem Content="Supervisor" />
            <ComboBoxItem Content="Administrador" />
          </ComboBox>
        </StackPanel>
        <StackPanel x:Name="PinFields" Margin="0,12,0,0">
          <TextBlock Text="PIN (4 a 12 dígitos)" Style="{StaticResource FieldLabel}" />
          <PasswordBox x:Name="PinBox" MaxLength="12" Padding="10,8" Margin="0,0,0,14" />
          <TextBlock Text="Confirmar PIN" Style="{StaticResource FieldLabel}" />
          <PasswordBox x:Name="ConfirmPinBox" MaxLength="12" Padding="10,8" />
          <TextBlock Text="El PIN se guarda protegido y no se puede consultar después." Foreground="#667085" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#B42318" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="20" />
      <Grid Grid.Row="4" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Content="Cancelar" Click="Cancel_Click" />
        <Button Grid.Column="2" x:Name="SaveButton" Content="Guardar" Click="Save_Click" Background="#155EEF" Foreground="White" />
      </Grid>
    </Grid>
  </Border>
</Window>

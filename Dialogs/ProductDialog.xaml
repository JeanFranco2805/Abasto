<Window x:Class="SupermercadoPOS.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto" Width="760" Height="650" MinWidth="700" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#101722" FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,15">
      <TextBlock x:Name="TitleText" Text="Producto" FontSize="24" FontWeight="Bold" Foreground="#F1F4F8" />
      <TextBlock Text="Catálogo e inventario de la caja local" Foreground="#9AA9BB" Margin="0,4,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Background="#1B2938" CornerRadius="5" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.15*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="Código de barras" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="BarcodeBox" Margin="0,0,0,11" />
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="Nombre del producto" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Margin="0,0,0,11" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CategoryBox" Margin="0,0,0,11" />
          </StackPanel>

          <Grid Grid.Row="3" Margin="0,0,0,11">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="UnitBox" SelectedIndex="0" ToolTip="Unidad de venta y de inventario" />
                <Button Grid.Column="1" Content="…" Click="ManageUnits_Click" Padding="4,4"
                        Margin="6,0,0,0" ToolTip="Administrar unidades" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Precio unitario" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="PriceBox" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="IVA (%)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="TaxBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Existencias" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="StockBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Mínimo de stock" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="MinimumStockBox" Text="0" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#FFB4AB" TextWrapping="Wrap"
                     VerticalAlignment="Bottom" Margin="0,10,0,0" />
        </Grid>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Imagen del producto" Style="{StaticResource FieldLabel}" />
          <Border Grid.Row="1" MinHeight="210" Margin="0,0,0,8" Padding="8"
                  Background="#141E2A" BorderBrush="#3A4B63" BorderThickness="1" CornerRadius="5">
            <Grid>
              <Image x:Name="ImagePreview" Stretch="Uniform" />
              <StackPanel x:Name="EmptyImageHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False">
                <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                           Foreground="#8FB4EA" HorizontalAlignment="Center" />
                <TextBlock Text="Sin imagen" FontSize="12" Foreground="#9AA9BB"
                           HorizontalAlignment="Center" Margin="0,7,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock x:Name="ImageNameText" Grid.Row="2" Text="JPG, PNG o BMP · máximo 10 MB"
                     FontSize="11" Foreground="#9AA9BB" TextTrimming="CharacterEllipsis"
                     Margin="0,0,0,10" />
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="Elegir imagen" Click="SelectImage_Click" Background="#2E6BC7" Foreground="White"
                    Padding="10,8" />
            <Button Grid.Column="1" Content="Quitar" Click="RemoveImage_Click" Padding="9,8"
                    Margin="8,0,0,0" />
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,10,0" />
      <Button Content="Guardar producto" Click="Save_Click" Background="#2E6BC7" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
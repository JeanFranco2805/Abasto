<Window x:Class="SupermercadoPOS.Dialogs.ShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turno de caja"
        Width="510" Height="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D1724"
        FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,15">
      <TextBlock Text="Turno de caja" FontSize="24" FontWeight="Bold" Foreground="#F0F4F8" />
      <TextBlock x:Name="ModeText" Foreground="#A8B5C5" Margin="0,4,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="#152438" CornerRadius="12" Padding="18">
      <StackPanel>
        <TextBlock Text="Acción" FontWeight="SemiBold" Foreground="#D6E0EB" Margin="0,0,0,5" />
        <ComboBox x:Name="ActionBox" SelectionChanged="Action_SelectionChanged" Margin="0,0,0,14" />
        <TextBlock x:Name="ExpectedText" Foreground="#C3CFDC" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock x:Name="AmountLabel" Text="Valor" FontWeight="SemiBold" Foreground="#D6E0EB" Margin="0,0,0,5" />
        <TextBox x:Name="AmountBox" Text="0" Margin="0,0,0,12" />
        <TextBlock Text="Motivo (obligatorio para entrada o salida)" FontWeight="SemiBold" Foreground="#D6E0EB" Margin="0,0,0,5" />
        <TextBox x:Name="ReasonBox" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
        <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,10,0" />
      <Button Content="Continuar" Click="Continue_Click" Background="#155EEF" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>

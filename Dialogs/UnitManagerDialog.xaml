<Window x:Class="SupermercadoPOS.Dialogs.UnitManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unidades de medida" Width="560" Height="490" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#101722" FontFamily="Segoe UI">
  <Border Margin="22" Padding="24" Background="#1B2938" CornerRadius="5">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Unidades de medida" FontSize="23" FontWeight="Bold" Foreground="#F1F4F8" />
        <TextBlock Text="Elige una unidad estándar o agrega las que usa tu tienda."
                   Foreground="#9AA9BB" Margin="0,4,0,0" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,20,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="UnitCodeBox" MaxLength="8" ToolTip="Código corto, por ejemplo BOLSA o M2" />
        <Button Grid.Column="1" Content="Agregar" Click="Add_Click" Background="#2E6BC7"
                Foreground="White" Margin="10,0,0,0" />
      </Grid>

      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="UNIDADES DISPONIBLES" FontSize="10" FontWeight="Bold"
                   Foreground="#9AA9BB" Margin="0,0,0,8" />
        <ListBox x:Name="UnitsList" Grid.Row="1" Background="#141E2A" Foreground="#CCD5E1"
                 BorderBrush="#3A4B63" BorderThickness="1" SelectionChanged="UnitsList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="#24354A" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="#304664" />
                        <Setter Property="Foreground" Value="#F1F4F8" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>

      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="RemoveUnitButton" Grid.Column="1" Content="Eliminar" Click="Remove_Click"
                IsEnabled="False" Margin="0,0,10,0" />
        <Button Grid.Column="2" Content="Listo" Click="Close_Click" Background="#2E6BC7" Foreground="White" />
      </Grid>
    </Grid>
  </Border>
</Window>

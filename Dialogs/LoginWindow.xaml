<Window x:Class="SupermercadoPOS.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingreso al punto de venta"
        Width="460" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        FontFamily="Segoe UI">
  <Border Margin="26" Padding="30" Background="White" CornerRadius="16">
    <StackPanel>
      <TextBlock Text="SUPERMERCADO POS" FontSize="13" FontWeight="Bold" Foreground="#155EEF" />
      <TextBlock Text="Iniciar sesión" FontSize="27" FontWeight="Bold" Foreground="#172B4D" Margin="0,8,0,3" />
      <TextBlock Text="Ingresa con tu usuario y PIN. Luego accederás a Caja, Inventario, Turnos y Reportes."
                 FontSize="14" Foreground="#667085" Margin="0,0,0,24" TextWrapping="Wrap" />
      <TextBlock Text="Usuario" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,6" />
      <TextBox x:Name="UsernameBox" Text="cajero" Margin="0,0,0,16" />
      <TextBlock Text="PIN" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,6" />
      <PasswordBox x:Name="PinBox" Padding="10,8" FontSize="16" MaxLength="12" Password="1111" />
      <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="20" />
      <Button Content="Entrar" Click="Login_Click" IsDefault="True" Background="#155EEF" Foreground="White" Margin="0,12,0,0" Padding="14,12" />
      <Border Background="#F2F4F7" CornerRadius="8" Padding="12" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="Cuentas de demostración" FontSize="12" FontWeight="Bold" Foreground="#475467" />
          <TextBlock Text="cajero / 1111    supervisor / 1234    admin / 2468" FontSize="12" Foreground="#667085" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>

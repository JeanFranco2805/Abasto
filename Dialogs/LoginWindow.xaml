<Window x:Class="SupermercadoPOS.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingreso al punto de venta"
        Width="980" Height="660" MinWidth="920" MinHeight="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1A252A"
        FontFamily="Segoe UI" xml:lang="es-CO">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.96*" />
      <ColumnDefinition Width="1.04*" />
    </Grid.ColumnDefinitions>

    <Border Padding="44,42" Background="#17282D">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                     Foreground="#71CABB" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SUPERMERCADO" FontSize="11" FontWeight="Bold" Foreground="#A1AEAB" />
            <TextBlock Text="Punto de venta" FontSize="14" FontWeight="SemiBold" Foreground="#EEF2EF" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,18">
          <TextBlock Text="Tu tienda, en orden." FontSize="30" FontWeight="SemiBold"
                     Foreground="#EEF2EF" TextWrapping="Wrap" />
          <TextBlock Text="Ventas, inventario y turnos de caja en un mismo lugar."
                     FontSize="14" Foreground="#A1AEAB" TextWrapping="Wrap" Margin="0,10,0,28" />

          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Border Width="2" Height="28" Background="#36A995" Margin="0,0,13,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Venta" FontSize="13" FontWeight="SemiBold" Foreground="#EEF2EF" />
                <TextBlock Text="Busca, escanea y cobra" FontSize="11" Foreground="#A1AEAB" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Border Width="2" Height="28" Background="#36A995" Margin="0,0,13,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Inventario" FontSize="13" FontWeight="SemiBold" Foreground="#EEF2EF" />
                <TextBlock Text="Productos y existencias" FontSize="11" Foreground="#A1AEAB" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="2" Height="28" Background="#36A995" Margin="0,0,13,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Caja" FontSize="13" FontWeight="SemiBold" Foreground="#EEF2EF" />
                <TextBlock Text="Turnos y reportes" FontSize="11" Foreground="#A1AEAB" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="#36A995" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="Disponible sin internet" FontSize="12" Foreground="#A1AEAB" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="#1A252A" Padding="54,42">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="ACCESO DE CAJA" FontSize="10" FontWeight="Bold" Foreground="#71CABB" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,20">
          <TextBlock Text="Iniciar sesión" FontSize="29" FontWeight="SemiBold" Foreground="#EEF2EF" />
          <TextBlock Text="Ingresa tu usuario y PIN para continuar."
                     FontSize="14" Foreground="#A1AEAB" TextWrapping="Wrap" Margin="0,7,0,27" />

          <TextBlock Text="Usuario" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5D2" Margin="0,0,0,7" />
          <TextBox x:Name="UsernameBox" Text="cajero" FontSize="15" Padding="13,11"
                   BorderBrush="#354246" Margin="0,0,0,18" />

          <TextBlock Text="PIN" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5D2" Margin="0,0,0,7" />
          <PasswordBox x:Name="PinBox" Padding="13,11" FontSize="16" MaxLength="12" Password="1111"
                       BorderBrush="#354246" />

          <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" Margin="0,9,0,0"
                     MinHeight="18" FontSize="12" />
          <Button Content="Entrar al punto de venta" Click="Login_Click" IsDefault="True"
                  Background="#36A995" Foreground="#071A18" BorderBrush="#36A995" Height="48"
                  FontSize="14" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#303A3D" BorderThickness="0,1,0,0" Padding="0,14,0,0">
          <StackPanel>
            <TextBlock Text="CUENTAS DE DEMOSTRACIÓN" FontSize="10" FontWeight="Bold" Foreground="#A1AEAB"
                       Margin="0,0,0,9" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="CAJERO" FontSize="9" FontWeight="SemiBold" Foreground="#909E9B" />
                <TextBlock Text="cajero · 1111" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5D2" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="SUPERVISOR" FontSize="9" FontWeight="SemiBold" Foreground="#909E9B" />
                <TextBlock Text="supervisor · 1234" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5D2" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="ADMIN" FontSize="9" FontWeight="SemiBold" Foreground="#909E9B" />
                <TextBlock Text="admin · 2468" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5D2" Margin="0,3,0,0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
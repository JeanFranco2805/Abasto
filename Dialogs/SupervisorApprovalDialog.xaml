<Window x:Class="Abasto.Dialogs.SupervisorApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorización de supervisor"
        Width="470" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101722"
        FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Autorización requerida" FontSize="23" FontWeight="Bold" Foreground="#F1F4F8" />
      <TextBlock x:Name="MessageText" Foreground="#9AA9BB" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="#1B2938" CornerRadius="5" Padding="18">
      <StackPanel>
        <TextBlock Text="Usuario autorizador" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UsernameBox" Margin="0,0,0,12" />
        <TextBlock Text="PIN" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PinBox" Padding="10,8" FontSize="14" />
        <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,10,0" />
      <Button Content="Autorizar" Click="Authorize_Click" Background="#2E6BC7" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>

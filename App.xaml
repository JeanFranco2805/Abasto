<Application x:Class="SupermercadoPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#155EEF" />
    <SolidColorBrush x:Key="InkBrush" Color="#172B4D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F8" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="#E9EEF5" />
      <Setter Property="Foreground" Value="#172B4D" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#84ADFF" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Width" Value="218" />
      <Setter Property="Padding" Value="15,13" />
      <Setter Property="Margin" Value="5,3" />
      <Setter Property="Foreground" Value="#475467" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectionMark" Background="#155EEF" CornerRadius="2" Margin="0,4" Visibility="Collapsed" />
                <TextBlock Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}"
                           VerticalAlignment="Center" Margin="11,0,11,0" />
                <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#EAF1FF" />
                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="#155EEF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#F2F4F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
      <Setter Property="Width" Value="216" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Foreground" Value="#475467" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectionMark" Background="#155EEF" CornerRadius="2"
                        Margin="0,5" Visibility="Collapsed" />
                <Border x:Name="IconShell" Grid.Column="1" Width="36" Height="36"
                        Background="#E1E8F0" CornerRadius="10" Margin="0,0,11,0">
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Foreground="{TemplateBinding Foreground}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
                <TextBlock x:Name="TabChevron" Grid.Column="3" Text="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#155EEF"
                           VerticalAlignment="Center" Margin="8,0,5,0" Opacity="0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#F8FAFC" />
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#E3EAF2" />
                <Setter TargetName="IconShell" Property="Background" Value="#D7E4F3" />
                <Setter Property="Foreground" Value="#172B4D" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#84ADFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#DCE6F3" />
                <Setter TargetName="TabBorder" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#243B5A" BlurRadius="12" ShadowDepth="2" Opacity="0.08" />
                  </Setter.Value>
                </Setter>
                <Setter TargetName="IconShell" Property="Background" Value="#155EEF" />
                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="TabChevron" Property="Opacity" Value="0.8" />
                <Setter Property="Foreground" Value="#142B49" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarTabControlStyle" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#E9EEF4" BorderBrush="#E0E6EE" BorderThickness="1"
                      CornerRadius="17" Margin="0,0,14,0" />
              <Grid Grid.Column="0" Margin="10,15,26,14">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,2,8,24">
                  <Border Width="42" Height="42" Background="#142B49" BorderBrush="#FFFFFF"
                          BorderThickness="2" CornerRadius="13" Margin="0,0,11,0">
                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TU TIENDA" FontSize="10" FontWeight="Bold" Foreground="#155EEF" />
                    <TextBlock Text="Gestión diaria" FontSize="14" FontWeight="Bold"
                               Foreground="#142B49" Margin="0,2,0,0" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="IR A" FontSize="10" FontWeight="Bold"
                           Foreground="#7A8798" Margin="11,0,0,8" />
                <TabPanel Grid.Row="2" IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                          VerticalAlignment="Top" />
                <Border Grid.Row="3" Background="White" BorderBrush="#DCE4ED" BorderThickness="1"
                        CornerRadius="12" Padding="11,10" Margin="3,12,3,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" Background="#EAF1FF" CornerRadius="9" Margin="0,0,9,0">
                      <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                 Foreground="#155EEF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="OPERACIÓN DIARIA" FontSize="9" FontWeight="Bold" Foreground="#7A8798" />
                      <TextBlock Text="Caja · ventas · inventario" FontSize="11" FontWeight="SemiBold"
                                 Foreground="#142B49" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE4EF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF4" />
      <Setter Property="VerticalGridLinesBrush" Value="#E8EDF4" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#F7F9FC" />
      <Setter Property="AlternationCount" Value="2" />
      <Setter Property="ColumnHeaderHeight" Value="44" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#142D4A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="BorderBrush" Value="#294666" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1C4268" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#E8EDF4" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F1F6FF" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E8F0FF" />
          <Setter Property="Foreground" Value="#172B4D" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DCE9FF" />
          <Setter Property="Foreground" Value="#173A5E" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
  </Application.Resources>
</Application>
